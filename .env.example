# Event-issued key. Keep it on the server; never use NEXT_PUBLIC_.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
MAX_AGENT_STEPS=12
MAX_QLOO_CALLS=12
QLOO_TIMEOUT_MS=8000

# Optional language layer. Empty key keeps the complete deterministic workflow.
OPENROUTER_API_KEY=
LLM_MODEL=google/gemma-4-31b-it:free
LLM_FALLBACK_MODEL=openrouter/free
LLM_TIMEOUT_MS=4000
LLM_MAX_RETRIES=0
# Optional HTTPS production origin for attribution; local development needs none.
APP_URL=
